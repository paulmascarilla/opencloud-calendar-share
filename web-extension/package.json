    "test:ui": "node test/ui-smoke.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opencloud-eu/design-system": "8.1.0",
    "@opencloud-eu/extension-sdk": "8.1.0",
    "@opencloud-eu/tsconfig": "8.1.0",
    "@opencloud-eu/web-client": "8.1.0",
    "@opencloud-eu/web-pkg": "8.1.0",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.0.3",
    "vue": "^3.4.21",
    "vue-tsc": "^3.2.6",
    "vue3-gettext": "4.0.1"
  },
  "dependencies": {
    "@fullcalendar/core": "6.1.22",
