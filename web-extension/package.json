{
  "name": "web-app-calendar",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCloud Web calendar: CalDAV events (Radicale) and calendar sharing between users",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
